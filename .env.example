APP_ENV=production
APP_NAME=manaai-api
APP_VERSION=0.1.0
APP_API_KEY=replace_with_server_api_key
OPENAI_API_KEY=replace_with_server_secret
OPENAI_MODEL=gpt-5.4-nano
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_OUTPUT_TOKENS=512
OPENAI_TEMPERATURE=0.2
LOG_LEVEL=INFO
CORS_ORIGINS=["https://example.com"]
MARKETING_DATABASE_PATH=/data/manaai.db
MARKETING_CONVERSION_ACTION_TYPES=["purchase","lead","complete_registration","offsite_conversion.fb_pixel_purchase","onsite_conversion.lead_grouped"]
MARKETING_VALUE_ACTION_TYPES=["purchase","offsite_conversion.fb_pixel_purchase"]
META_GRAPH_BASE_URL=https://graph.facebook.com
META_GRAPH_API_VERSION=v25.0
META_APP_ID=replace_with_meta_app_id
META_BUSINESS_ID=replace_with_meta_business_id
META_ACCESS_TOKEN=replace_with_meta_system_user_access_token
META_AD_ACCOUNT_IDS=[]
META_REQUEST_TIMEOUT_SECONDS=30
META_PAGE_LIMIT=100
META_MAX_PAGES=25
META_BUSINESS_FIELDS=["id","name"]
META_PIXEL_FIELDS=["id","name","owner_business","last_fired_time","is_unavailable"]
META_CUSTOM_CONVERSION_FIELDS=["id","name","description","custom_event_type","event_source_type","pixel","rule","default_conversion_value","creation_time","last_fired_time","is_archived"]
META_CUSTOM_AUDIENCE_FIELDS=["id","name","description","subtype","customer_file_source","data_source","delivery_status","operation_status","permission_for_actions","approximate_count","lookalike_spec","retention_days","time_content_updated","time_created","time_updated"]
META_CAMPAIGN_FIELDS=["id","name","objective","status","effective_status","created_time","updated_time","start_time","stop_time","daily_budget","lifetime_budget","bid_strategy"]
META_ADSET_FIELDS=["id","name","campaign_id","status","effective_status","optimization_goal","billing_event","bid_strategy","daily_budget","lifetime_budget","targeting","created_time","updated_time","start_time","end_time"]
META_AD_FIELDS=["id","name","campaign_id","adset_id","creative","status","effective_status","created_time","updated_time"]
META_CREATIVE_FIELDS=["id","name","title","body","object_type","object_url","call_to_action_type","thumbnail_url","image_url","object_story_id","effective_object_story_id","object_story_spec","asset_feed_spec","instagram_permalink_url"]
META_AD_ACCOUNT_FIELDS=["id","name","currency","timezone_name","account_status","business"]
META_INSIGHTS_FIELDS=["account_id","account_name","campaign_id","campaign_name","adset_id","adset_name","ad_id","ad_name","date_start","date_stop","spend","impressions","reach","clicks","inline_link_clicks","actions","action_values"]
META_ACTION_ATTRIBUTION_WINDOWS=["1d_click","7d_click"]
