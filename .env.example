META_INSIGHTS_FIELDS=["account_id","account_name","campaign_id","campaign_name","adset_id","adset_name","ad_id","ad_name","date_start","date_stop","spend","impressions","reach","clicks","inline_link_clicks","actions","action_values"]
META_ACTION_ATTRIBUTION_WINDOWS=["1d_click","7d_click"]

MANA_RETENTION_EXPIRY_ENABLED=false
MANA_COLLECTION_TARIFFS_ENABLED=false
MANA_COLLECTION_TARIFF_POLICY={"maximum_batches":10000,"maximum_age_seconds":180,"claim_seconds":30}
MANA_RETENTION_EXPIRY_POLICY={"notice_within_hours":72,"maximum_profile_age_seconds":180,"minimum_outreach_interval_hours":24,"urgent_notice_cooldown_hours":24,"maximum_profiles":10000,"maximum_changes":50000}

# Local single-chat tariff currency clarification; no production activation.
MANA_CLIENT_UPSELL_CURRENCY_ENABLED=false

# Local captured tariff replies await one result in their original chat turn.
MANA_UPSELL_INLINE_RESULTS_ENABLED=false

# New captured manager calls may carry typed tariff terms; no production activation.
MANA_PARENT_TOUCH_TARIFF_HANDOFF_ENABLED=false

# Captured lossless host/schema presentation; no source, quota or production activation.
MANA_FAMILY_COMPACT_INPUTS_ENABLED=false
MANA_PARENT_TOUCH_COMPACT_PUBLICATION_ENABLED=false
