APP_ENV=production
APP_NAME=manaai-api
APP_VERSION=0.1.0
APP_API_KEY=replace_with_server_api_key
AUTH_FAILURE_LIMIT=10
AUTH_FAILURE_WINDOW_SECONDS=60
API_RATE_LIMIT_REQUESTS=60
API_RATE_LIMIT_WINDOW_SECONDS=60
MANA_TELEGRAM_AUTH_ENABLED=true
MANA_TELEGRAM_BOT_TOKEN=
MANA_TELEGRAM_BOT_USERNAME=
MANA_OTP_HMAC_SECRET=
MANA_BOOTSTRAP_ADMIN_TELEGRAM_IDS=976835256,51456737
MANA_OTP_TTL_SECONDS=60
MANA_OTP_RESEND_COOLDOWN_SECONDS=30
MANA_OTP_MAX_VERIFY_ATTEMPTS=5
MANA_OTP_REQUEST_LIMIT_PER_USER=5
MANA_OTP_REQUEST_LIMIT_PER_IP=20
MANA_OTP_VERIFY_LIMIT_PER_IP=30
MANA_OTP_GLOBAL_REQUEST_LIMIT=1000
MANA_OTP_RATE_WINDOW_SECONDS=900
MANA_OTP_LOCKOUT_FAILURES=10
MANA_OTP_LOCKOUT_SECONDS=900
MANA_SESSION_TTL_SECONDS=28800
MANA_TRUSTED_ORIGINS=["https://ai-frontend.360rec.uz"]
MANA_AUTH_TEST_MODE=false
OPERATION_ALLOW_INSECURE_DEV_HEADERS=false
OPENAI_API_KEY=replace_with_server_secret
OPENAI_MODEL=gpt-5.4-nano
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_OUTPUT_TOKENS=16000
OPENAI_TEMPERATURE=0.2
OPENAI_REASONING_EFFORT=none
OPENAI_VERBOSITY=low
AUDIO_MODERATION_ENABLED=false
AI_AUDIO_MODERATION_AUTH_TOKEN=
AUDIO_MODERATION_TRANSCRIPTION_MODEL=gpt-transcribe
# File upload and transcription can take longer than ordinary text inference.
AUDIO_MODERATION_OPENAI_TIMEOUT_SECONDS=300
# Empty uses OPENAI_MODEL for transcript classification.
AUDIO_MODERATION_MODEL=
AUDIO_MODERATION_ALLOWED_AUDIO_HOSTS=["*.digitaloceanspaces.com"]
AUDIO_MODERATION_ALLOWED_CALLBACK_HOSTS=["api.360rec.uz"]
AUDIO_MODERATION_MAX_JOB_BODY_BYTES=32768
# OpenAI file transcription accepts at most 25 MB.
AUDIO_MODERATION_MAX_AUDIO_BYTES=25000000
AUDIO_MODERATION_WORKER_COUNT=4
AUDIO_MODERATION_QUEUE_CAPACITY=32
AUDIO_MODERATION_MAX_QUEUE_DELAY_SECONDS=120
AUDIO_MODERATION_DOWNLOAD_TIMEOUT_SECONDS=30
AUDIO_MODERATION_CALLBACK_TIMEOUT_SECONDS=10
AUDIO_MODERATION_CALLBACK_ATTEMPTS=3
AUDIO_MODERATION_CALLBACK_BACKOFF_SECONDS=0.5
AUDIO_MODERATION_SAFE_CONFIDENCE_THRESHOLD=0.90
AUDIO_MODERATION_TRANSCRIPT_CHUNK_CHARS=12000
AUDIO_MODERATION_MAX_TRANSCRIPT_CHUNKS=20
MANA_AI_MAX_REQUEST_BODY_BYTES=1048576
MANA_PARENT_CHAT_ENABLED=false
MANA_PARENT_TOUCH_ENABLED=false
# New asynchronous messages: Child-Safety review precedes Parent-Touch speech.
MANA_PARENT_TOUCH_REVIEW_FIRST_ENABLED=false
# New-role defaults only; legacy chat/stateless APIs keep OPENAI_MODEL. Flags remain off.
MANA_PARENT_TOUCH_MODEL=gpt-5.4
MANA_CHILD_SAFETY_ENABLED=false
MANA_CHILD_SAFETY_SOURCE_TOOLS_ENABLED=false
MANA_FAMILY_APP_USAGE_ENABLED=false
MANA_CHILD_SAFETY_MODEL=gpt-5.4-mini
# Required explicitly before enabling Child-Safety; token ceilings, not a USD forecast:
# MANA_CHILD_SAFETY_LIMITS={"server_daily_tokens":2000,"parent_daily_tokens":2000,"job_tokens":2000}
MANA_CHILD_SAFETY_MAX_OUTPUT_TOKENS=1024
MANA_CHILD_SAFETY_POLL_SECONDS=1
MANA_PARENT_TOUCH_QUESTION_LIMIT=100
# Explicit backend recipient language/preferences permit first contact without chat history.
# These stay disabled until the isolated family service is separately released/configured.
MANA_PARENT_TOUCH_PROACTIVE_ENABLED=false
MANA_PARENT_PUSH_ENABLED=false
MANA_PARENT_PUSH_QUEUE_LIMIT=1000
MANA_PARENT_PUSH_MAX_AGE_SECONDS=3600
MANA_PARENT_PUSH_DAILY_ATTEMPT_LIMIT=100
MANA_CONVERSION_ENABLED=false
MANA_CONVERSION_CONVERSATION_ENABLED=false
# Keep false by default during testing; never grant ordinary customer accounts.
# Scoped live tests apply only to explicitly designated test accounts.
MANA_CONVERSION_TRIAL_GRANTS_ENABLED=false
# Optional account verification on eligible backend events only; no periodic scan.
MANA_CONVERSION_ACCOUNT_SOURCE_ENABLED=false
# Shared, exact-child Firestore reads; no scans, listeners or automatic refresh.
MANA_FAMILY_SOURCES_ENABLED=false
MANA_FAMILY_FIREBASE_MANA_CONFIRMED=false
MANA_FAMILY_SOURCE_SAFETY_ENABLED=false
MANA_FAMILY_SOURCE_DATABASE_PATH=data/mana-family-sources.sqlite3
MANA_FAMILY_SOURCE_LIMITS={"requests_per_24h":100,"document_units_per_24h":200,"minimum_interval_seconds":21600}
MANA_FAMILY_SOURCE_TIMEOUT_SECONDS=30
MANA_FAMILY_SOURCE_MAXIMUM_AGE_SECONDS=21600
MANA_FAMILY_COLLECTION_ENABLED=false
MANA_FAMILY_SOURCE_REVIEWS_ENABLED=false
MANA_FAMILY_DAY_USAGE_ENABLED=false
MANA_FAMILY_DAY_REVIEWS_ENABLED=false
MANA_FAMILY_USAGE_COMPARISONS_ENABLED=false
MANA_COLLECTION_DAY_USAGE_ENABLED=false
MANA_CONVERSION_SHARED_PROFILE_ENABLED=false
MANA_PARENT_TOUCH_MANAGER_ENABLED=false
MANA_CONVERSION_TRIAL_PERIODS_ENABLED=false
MANA_FAMILY_LOCATION_ENABLED=false
MANA_RETENTION_TRIAL_END_ENABLED=false
MANA_FAMILY_PARALLEL_WORKER_ENABLED=false
MANA_CHILD_SAFETY_REMAINDER_ENABLED=false
MANA_PARENT_SUPPORT_QUESTIONS_ENABLED=false
MANA_PARENT_TOUCH_CLARIFICATIONS_ENABLED=false
MANA_RETENTION_TRIAL_END_POLICY={"maximum_age_days":7,"maximum_captures":10000}
MANA_PARENT_REMINDERS_ENABLED=false
MANA_CLIENT_RETENTION_ENABLED=false
MANA_CLIENT_UPSELL_ENABLED=false
MANA_CLIENT_UPSELL_POLICY={"catalog_cooldown_seconds":21600,"catalog_reads_per_24h":4,"maximum_pending_global":100,"maximum_pending_per_parent":3,"claim_seconds":180}
MANA_CLIENT_RETENTION_POLICY={"inactive_chat_days":14,"daily_outreach_limit":20,"preparation_seconds":180}
MANA_PARENT_REMINDER_POLICY={"version":1,"maximum_active_per_parent":10,"maximum_active_global":1000,"parent_commands_per_24h":20,"global_commands_per_24h":500,"deliveries_per_24h":100,"maximum_delay_days":366,"confirmation_seconds":1800,"delivery_grace_seconds":3600,"ownership_lease_seconds":120}
MANA_FAMILY_SOURCE_REVIEW_POLICY={"version":1,"coalesce_seconds":3,"maximum_collection_age_seconds":21600,"maximum_events":100}
MANA_FAMILY_COLLECTION_DATABASE_PATH=data/mana-family-collection.sqlite3
MANA_FAMILY_COLLECTION_POLICY={"timezone":"Asia/Tashkent","reads_per_window":50,"page_size":25}
MANA_FAMILY_COLLECTION_POLL_SECONDS=30
# MANA_CONVERSION_ACCOUNT_READ_LIMITS={"cooldown_seconds":21600,"daily_limit":100}
# Supply reviewed JSON catalogs/policies only; free grants never create payments.
# MANA_CONVERSION_OFFERS=[]
MANA_PARENT_CHAT_DATABASE_PATH=data/mana-parent-chat.sqlite3
MANA_PARENT_CHAT_DAILY_TOKENS=2000
MANA_PARENT_CHAT_TIMEZONE=Asia/Tashkent
MANA_PARENT_CHAT_MAX_OUTPUT_TOKENS=512
MANA_PARENT_CHAT_HISTORY_TURNS=2
MANA_PARENT_CHAT_MAX_ATTEMPTS_PER_DAY=20
MANA_PARENT_CHAT_SOURCE_TIMEOUT_SECONDS=30
LOG_LEVEL=INFO
CORS_ORIGINS=["https://ai-frontend.360rec.uz"]
ADMIN_FASTAPI_BASE_URL=http://api:8000
MARKETING_DATABASE_PATH=/data/manaai.db
POSTGRES_DB=manaai
POSTGRES_USER=manaai
POSTGRES_PASSWORD=replace_with_database_password
OPERATION_DATABASE_URL=postgresql+asyncpg://manaai:replace_with_database_password@postgres:5432/manaai
OPERATION_AUTO_CREATE_SCHEMA=false
OPERATION_SCHEDULER_ENABLED=false
OPERATION_SCHEDULER_POLL_SECONDS=30
OPERATION_SCHEDULER_MAX_ATTEMPTS=3
OPERATION_SCHEDULER_PERMANENT_FAILURE_THRESHOLD=3
OPERATION_WORKER_HEARTBEAT_PATH=/tmp/mana-operation-worker-heartbeat
OPERATION_WORKER_HEARTBEAT_INTERVAL_SECONDS=15
OPERATION_WORKER_HEARTBEAT_MAX_AGE_SECONDS=60
OPERATION_JOB_TIMEOUT_SECONDS=900
OPERATION_DATA_RETENTION_DAYS=90
OPERATION_VERIFICATION_ATTEMPTS=4
OPERATION_VERIFICATION_DELAY_SECONDS=1.0
OPERATION_ADS_PROVIDER=fake_meta
OPERATION_PRODUCT_ACTIVITY_PROVIDER=fake
# Manual analysis of an existing minimized MANA collection; no provider refresh.
OPERATION_FAMILY_COLLECTION_ENABLED=false
OPERATION_FAMILY_COLLECTION_DATABASE_PATH=
OPERATION_FAMILY_COLLECTION_BINDING=
OPERATION_DRY_RUN=true
OPERATION_GLOBAL_KILL_SWITCH=false
OPERATION_GLOBAL_EXECUTION_LIMIT_PER_DAY=20
OPERATION_AGENT_EXECUTION_LIMIT_PER_DAY=10
OPERATION_ALLOW_SELF_APPROVAL=false
OPERATION_DEFAULT_ACTOR_ID=local-admin
OPERATION_DEFAULT_ROLE=viewer
OPERATION_VIEWER_API_KEY=replace_with_viewer_key
OPERATION_OPERATOR_API_KEY=replace_with_operator_key
OPERATION_APPROVER_API_KEY=replace_with_approver_key
OPERATION_ADMIN_API_KEY=replace_with_admin_key
