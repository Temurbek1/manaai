META_ADSET_FIELDS=["id","name","campaign_id","status","effective_status","optimization_goal","billing_event","bid_strategy","daily_budget","lifetime_budget","targeting","created_time","updated_time","start_time","end_time"]
META_AD_FIELDS=["id","name","campaign_id","adset_id","creative","status","effective_status","created_time","updated_time"]
META_CREATIVE_FIELDS=["id","name","title","body","object_type","object_url","call_to_action_type","thumbnail_url","image_url","object_story_id","effective_object_story_id","object_story_spec","asset_feed_spec","instagram_permalink_url"]
