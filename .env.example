MANAKIDS_API_USERNAME=
MANAKIDS_API_PASSWORD=
MANAKIDS_REQUEST_TIMEOUT_SECONDS=20
MANAKIDS_MAX_RETRIES=3
MANAKIDS_RETRY_BACKOFF_SECONDS=0.5
MANAKIDS_MAX_PAGES=20
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_ID=(default)
FIREBASE_SERVICE_ACCOUNT_FILE=
# Host-only path used by docker-compose.product-activity.yml; never commit the JSON file.
FIREBASE_SERVICE_ACCOUNT_HOST_FILE=
FIREBASE_ACTIVITY_COLLECTION=app_activity_events
FIREBASE_REQUEST_TIMEOUT_SECONDS=30
FIREBASE_MAX_ACTIVITY_DOCUMENTS=5000
# Shared by all Firestore sources in one run, including transport retries.
FIREBASE_MAX_DOCUMENT_READS_PER_RUN=25000
FIREBASE_MAX_PAGES_PER_RUN=30
FIREBASE_MAX_REQUESTS_PER_RUN=40
FIREBASE_MAX_RETRIES=3
FIREBASE_RETRY_BACKOFF_SECONDS=0.5
FIREBASE_OPERATIONAL_TELEMETRY_ENABLED=false
FIREBASE_PUBLIC_READ_ENABLED=false
FIREBASE_OPERATIONAL_MAX_DOCUMENTS_PER_COLLECTION=5000
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_FILE=
# Host-only path used by docker-compose.product-activity-ga4.yml; never commit the JSON file.
GA4_SERVICE_ACCOUNT_HOST_FILE=
GA4_API_BASE_URL=https://analyticsdata.googleapis.com/v1beta
GA4_REQUEST_TIMEOUT_SECONDS=30
GA4_DIMENSION_LIMIT=50
GA4_MAX_CONCURRENCY=5
GA4_MAX_RETRIES=3
